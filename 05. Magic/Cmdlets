# Run a clean, detailed traceroute
Test-NetConnection -ComputerName 8.8.8.8 -TraceRoute  or, Test-Netconnection google.com -Traceroute

# Convert file lengths to Megabytes instantly
Get-ChildItem | Select-Object Name, @{n="Size(MB)"; e={$_.Length / 1MB}}

# Convert file lengths into human-readable Megabytes instantly
Get-ChildItem *.* | Select-Object Name, @{Name="Size(MB)"; Expression={ [math]::round($_.Length / 1MB, 2) }}

# Instant GUI Data Filtering: Append | Out-GridView -PassThru

# Send Output Straight to Clipboard, Never copy text manually from the shell host
Get-Service | Where-Object Status -eq 'Running' | Set-Clipboard

# Enable PowerShell Remoting: Enable-PSRemoting -Force
(Enables PowerShell remoting on the target Windows computer and configures the required WinRM components)

# Check the WinRM service: Get-Service WinRM
(Displays the status and configuration of the Windows Remote Management (WinRM) service)

# Test WinRM connectivity: Test-WSMan SERVER01
(Tests whether the target computer responds to WS-Management requests. Replace SERVER01 with the actual computer name or appropriate hostname.)

# Start an interactive remote PowerShell session: Enter-PSSession -ComputerName SERVER01
(Run this from the administrator workstation. It Starts an interactive PowerShell session on the specified remote computer)

