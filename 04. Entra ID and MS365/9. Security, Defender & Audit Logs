# 1. Retrieve high/medium security alerts from Defender / Graph
Get-MgSecurityAlert -Top 20

# 2. Check security incidents
Get-MgSecurityIncident -Top 10

# 3. Query Entra ID sign-in logs (Troubleshooting Conditional Access / Auth failures)
Get-MgAuditLogSignIn -Top 50

# 4. Query Entra ID directory audit logs (Tracking admin modifications)
Get-MgAuditLogDirectoryAudit -Top 50

# 5. Search unified M365 audit log across Exchange, SharePoint, Teams (EXO Module)
Search-UnifiedAuditLog -StartDate (Get-Date).AddDays(-7) -EndDate (Get-Date) -Operations "UserLoggedIn" -ResultSize 100
