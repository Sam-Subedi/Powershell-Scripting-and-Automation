# 1. Reset user password
Update-MgUser -UserId "user@domain.com" `
              -PasswordProfile @{Password="NewSecurePassword123!"; ForceChangePasswordNextSignIn=$true}

# 2. List registered MFA / Auth methods for a user
Get-MgUserAuthenticationMethod -UserId "user@domain.com"

# 3. Remove a registered MFA method (e.g., lost phone scenario)
Remove-MgUserAuthenticationMethod -UserId "user@domain.com" -AuthenticationMethodId <MethodID>
