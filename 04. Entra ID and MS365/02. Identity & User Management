# 1. Retrieve specific user details
Get-MgUser -UserId "user@domain.com" | Select-DisplayName, UserPrincipalName, Id, AccountEnabled

# 2. List all users in tenant (Handles pagination automatically)
Get-MgUser -All -Property "displayName,userPrincipalName,accountEnabled"

# 3. Create a new Entra ID user
New-MgUser -DisplayName "Jane Doe" -UserPrincipalName "jdoe@domain.com" `
           -MailNickname "jdoe" -AccountEnabled:$true `
           -PasswordProfile @{Password="P@ssw0rd1234!"; ForceChangePasswordNextSignIn=$true}

# 4. Update user details (e.g., Department & Job Title)
Update-MgUser -UserId "user@domain.com" -Department "IT" -JobTitle "Systems Administrator"

# 5. Disable a user account (Offboarding / Incident Response)
Update-MgUser -UserId "user@domain.com" -AccountEnabled:$false

# 6. Delete a user account
Remove-MgUser -UserId "user@domain.com"

# 7. Check direct manager for a user
Get-MgUserManager -UserId "user@domain.com"

# 8. List all group/role memberships for a user
Get-MgUserMemberOf -UserId "user@domain.com"
