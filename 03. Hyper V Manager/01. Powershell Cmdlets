Quick Command:
Get-VMNetworkAdapter -All | ForEach-Object {
    $vlan = Get-VMNetworkAdapterVlan -VMNetworkAdapter $_

    [PSCustomObject]@{
        VM                = $_.VMName
        Adapter           = $_.Name
        Switch            = $_.SwitchName
        OperationMode     = $vlan.OperationMode
        AccessVLAN        = $vlan.AccessVlanId
        NativeVLAN        = $vlan.NativeVlanId
        AllowedVLANs      = $vlan.AllowedVlanIdList
        DynamicVLAN       = $vlan.DynamicVlanId
    }
} | Format-Table -AutoSize

